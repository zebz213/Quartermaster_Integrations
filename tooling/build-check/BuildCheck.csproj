<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-only harness for the Quartermaster Integrations sources.
    It compiles the real .cs files from the parent folder against hand-written stubs
    (Stubs.cs) for UnityEngine/TMPro/BepInEx/HarmonyLib/Valheim, because the game and the mod DLLs
    are not available on this machine. Its purpose is compiler diagnostics on OUR code - it is not
    the shipping project and its output must never be deployed.

    Run:  dotnet build /home/hermes/projects/valheim/quartermaster_integrations/build-check/BuildCheck.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>QuarterMaster_Integrations_CompileCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0649;CS0169;CS0067;CS0414;CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="../../qi_main.cs" Link="mod/qi_main.cs" />
    <Compile Include="../../aaacrafting_integration.cs" Link="mod/aaacrafting_integration.cs" />
    <Compile Include="../../adventurebackpacks_integration.cs" Link="mod/adventurebackpacks_integration.cs" />
    <Compile Include="../../extraslots_integration.cs" Link="mod/extraslots_integration.cs" />
    <Compile Include="../../mlui_integration.cs" Link="mod/mlui_integration.cs" />
    <Compile Include="../../aaabuildmenu_integration.cs" Link="mod/aaabuildmenu_integration.cs" />
    <Compile Include="../../epicloot_integration.cs" Link="mod/epicloot_integration.cs" />
    <Compile Include="../../planbuild_integration.cs" Link="mod/planbuild_integration.cs" />
    <Compile Include="../../wardislove_integration.cs" Link="mod/wardislove_integration.cs" />
    <Compile Include="../../ward_range.cs" Link="mod/ward_range.cs" />
    <Compile Include="../../qi_debugger.cs" Link="mod/qi_debugger.cs" />
  </ItemGroup>

</Project>
